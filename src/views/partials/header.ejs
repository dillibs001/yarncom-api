<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Yarncom | Community Storytelling</title>
    <style> 
        ::-webkit-scrollbar {width: 8px;}
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #6366f1; border-radius: 10px; } 

    </style>
</head>
<body class="bg-slate-50 text-slate-900 font-sans min-h-screen selection:bg-indigo-100 selection:text-indigo-700">
    <nav class="bg-white/80 backdrop-blur-md border-b border-slate-200 py-4 sticky top-0 z-50">
        <div class="container mx-auto px-6 flex justify-between items-center">
            <a href="/" class="text-3xl font-black text-indigo-600 tracking-tighter hover:scale-105 transition-transform duration-300 block">
                Yarncom<span class="text-indigo-600">.</span>

            </a>
            <div class="flex items-center space-x-8">
                <a href="/blogs" class="text-sm font-semibold text-slate-600 hover:text-indigo-600 transition">Explore</a>
                <% if (typeof user !== 'undefined' && user) { %>
                    <a href ="/blogs/my-yarns" class="text-sm font-semibold text-slate-600 hover:text-indigo-600 transition">My Yarns</a>
                    <div class="h-8 w-[1px] bg-slate-200"></div>
                    <a href="/auth/logout" class="bg-slate-900 text-white px-5 py-2 rounded-full text-sm font-bold hover:bg-slate-700 transition shadow-lg shadow-slate-200">Sign Out</a>
                    <% } else { %>
                        <a href="/auth/login" class="text-sm font-semibold text-slate-600 hover:text-indigo-600 transition">Login</a>
                        <a href="/auth/signup" class="bg-indigo-600 text-white px-6 py-2 rounded-full text-sm font-bold hover:bg-indigo-700 transition shadow-lg shadow-indigo-100">Join Community</a>
                        <% } %>
            

            </div>

        </div>
        
    </nav>

