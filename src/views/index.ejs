<%- include('partials/header') %>

<main class="container mx-auto mt-16 px-6 pb-20">
    <!-- Hero / Search Section -->
    <header class="mb-20 max-w-3xl mx-auto text-center">
        <div class="inline-block px-4 py-1.5 mb-6 rounded-full bg-indigo-50 border border-indigo-100">
            <span class="text-[11px] font-black uppercase tracking-widest text-indigo-600">The Discovery Layer</span>
        </div>
        <h1 class="text-6xl font-black tracking-tight mb-6 text-slate-900">
            Freshly Spun <span class="text-indigo-600">Yarns.</span>
        </h1>
        <p class="text-slate-500 text-xl font-medium leading-relaxed">
            A real-time feed of thoughts, tutorials, and stories from the Yarncom community.
        </p>
        
        <form action="/blogs" method="GET" class="mt-12 flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1 group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400 group-focus-within:text-indigo-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <input 
                    type="text" 
                    name="search" 
                    placeholder="Search titles or #tags..." 
                    class="w-full pl-12 pr-4 py-4 bg-white border border-slate-200 rounded-2xl shadow-sm focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 outline-none transition-all text-lg"
                >
            </div>
            <button class="bg-indigo-600 text-white px-10 py-4 rounded-2xl font-black text-lg hover:bg-indigo-700 hover:-translate-y-0.5 active:translate-y-0 transition-all shadow-xl shadow-indigo-100">
                Filter Feed
            </button>
        </form>
    </header>

    <!-- The Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (blogs.length === 0) { %>
            <div class="col-span-full py-32 text-center bg-white rounded-[40px] border-4 border-dashed border-slate-100 flex flex-col items-center justify-center">
                <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-10 h-10 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                </div>
                <p class="text-slate-400 text-xl font-bold italic">The library is empty. Be the first to spin a yarn!</p>
            </div>
        <% } %>

        <% blogs.forEach(blog => { %>
            <article class="group bg-white rounded-[32px] overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl hover:shadow-indigo-100/50 transition-all duration-500 flex flex-col h-full">
                <!-- Blog Content Area -->
                <div class="p-8 flex-1">
                    <div class="flex flex-wrap gap-2 mb-6">
                        <% blog.tags.forEach(tag => { %>
                            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-500 bg-indigo-50 px-3 py-1.5 rounded-lg">
                                #<%= tag %>
                            </span>
                        <% }) %>
                    </div>
                    
                    <h2 class="text-2xl font-bold mb-4 leading-tight text-slate-800 group-hover:text-indigo-600 transition-colors">
                        <a href="/blogs/<%= blog._id %>">
                            <%= blog.title %>
                        </a>
                    </h2>
                    
                    <p class="text-slate-500 line-clamp-3 text-base leading-relaxed mb-6">
                        <%= blog.description || blog.body.substring(0, 120) + '...' %>
                    </p>
                </div>

                <!-- Footer Area -->
                <div class="px-8 pb-8">
                    <div class="flex items-center justify-between pt-6 border-t border-slate-50">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-indigo-600 rounded-2xl flex items-center justify-center text-white font-black text-sm rotate-3 group-hover:rotate-0 transition-transform">
                                <%= blog.author.first_name[0] %>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-xs font-black text-slate-800 tracking-tight">
                                    <%= blog.author.first_name %> <%= blog.author.last_name %>
                                </span>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Author</span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end">
                            <span class="text-[10px] font-black text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded uppercase">
                                ⏱️ <%= blog.reading_time %> Min
                            </span>
                            <span class="text-[9px] font-bold text-slate-300 uppercase mt-1">
                                <%= blog.read_count %> Views
                            </span>
                        </div>
                    </div>
                </div>
            </article>
        <% }) %>
    </div>

    <!-- Pagination -->
    <% if (blogs.length > 0) { %>
    <footer class="mt-24 flex justify-center items-center gap-6">
        <% if (page > 1) { %>
            <a href="/blogs?page=<%= parseInt(page) - 1 %>" class="px-8 py-3 bg-white border border-slate-200 rounded-2xl font-black text-sm text-slate-600 hover:bg-indigo-50 hover:border-indigo-200 hover:text-indigo-600 transition-all active:scale-95 shadow-sm">
                ← Previous Page
            </a>
        <% } %>
        
        <div class="bg-indigo-600 text-white w-10 h-10 rounded-xl flex items-center justify-center font-black shadow-lg shadow-indigo-200">
            <%= page %>
        </div>

        <% if (blogs.length === 20) { %>
            <a href="/blogs?page=<%= parseInt(page) + 1 %>" class="px-8 py-3 bg-white border border-slate-200 rounded-2xl font-black text-sm text-slate-600 hover:bg-indigo-50 hover:border-indigo-200 hover:text-indigo-600 transition-all active:scale-95 shadow-sm">
                Next Page →
            </a>
        <% } %>
    </footer>
    <% } %>
</main>

<%- include('partials/footer') %>